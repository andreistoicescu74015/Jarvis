# Copy this file to `.env` and fill in values. `.env` is gitignored - never commit it.
# Every variable is optional; sensible defaults apply.

# The bot owner's WhatsApp id (enables owner-only commands such as shutdown/restart/logout).
# RECOMMENDED in production. If left empty, the first user to send `jarvis owner claim` becomes the
# owner until the next restart - fine for a quick local run, but set this explicitly for a stable
# owner, especially in a container that auto-restarts (the claim resets on every restart).
# Use the normalized JID, e.g. 40712345678@s.whatsapp.net (run `jarvis whoami` to see yours).
OWNER_JID=

# Log verbosity: debug | info | warn | error  (default: info)
LOG_LEVEL=info

# The word that addresses the bot (default: jarvis)
JARVIS_PREFIX=jarvis

# How often (ms) the background runner fires due scheduled messages and drains the broadcast
# queue (default: 30000). Lower it to test schedules/broadcast faster locally.
JARVIS_TICK_MS=30000

# Proactive-send budget (ban-safety on the unofficial client). Scheduled messages and
# broadcasts are paced to these rates; normal replies are never throttled. The per-command
# caps apply to each proactive command on its own; the global caps are a backstop across all
# of them. The hourly rate sets an even spacing (so output never bursts); the daily is a hard
# ceiling. Defaults: 60/hour and 300/day per command, 120/hour and 600/day global.
JARVIS_SEND_PER_HOUR=60
JARVIS_SEND_PER_DAY=300
JARVIS_SEND_GLOBAL_PER_HOUR=120
JARVIS_SEND_GLOBAL_PER_DAY=600
