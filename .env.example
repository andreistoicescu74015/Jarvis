# Copy this file to `.env` and fill in values. `.env` is gitignored - never commit it.
# Every variable is optional; sensible defaults apply.

# The bot owner's WhatsApp id (enables owner-only commands such as shutdown/restart/logout).
# If left empty, the first user to invoke an owner-only command claims ownership until restart.
# Use the normalized JID, e.g. 40712345678@s.whatsapp.net (run `jarvis whoami` to see yours).
OWNER_JID=

# Log verbosity: debug | info | warn | error  (default: info)
LOG_LEVEL=info

# The word that addresses the bot (default: jarvis)
JARVIS_PREFIX=jarvis
