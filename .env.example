# Copy this file to `.env` and fill in values. `.env` is gitignored - never commit it.
# Every variable is optional; sensible defaults apply.

# The bot owner's WhatsApp id (enables owner-only commands such as shutdown/restart/logout).
# RECOMMENDED in production. If left empty, the first user to send `jarvis owner claim` becomes the
# owner until the next restart - fine for a quick local run, but set this explicitly for a stable
# owner, especially in a container that auto-restarts (the claim resets on every restart).
# Use the normalized JID, e.g. 40712345678@s.whatsapp.net (run `jarvis whoami` to see yours).
OWNER_JID=

# Until an owner exists (OWNER_JID above, or someone runs `jarvis owner claim` in a DM) Jarvis stays
# DORMANT: silent in every group, and in a private chat only the `owner` command responds. Set to
# off to let the bot respond to anyone even with no owner. Default: on.
JARVIS_REQUIRE_OWNER=on

# Per-group activation: with this on, Jarvis stays SILENT in every group until the owner activates it
# there - `jarvis groups activate` from inside the group, or `jarvis groups activate <id>` from
# anywhere (ids from `jarvis groups`). This keeps the bot inert in any group it was added to until you
# authorize it. Activation persists. Set to off to let the bot act in every group it is in. Default: on.
JARVIS_REQUIRE_ACTIVATION=on

# Log verbosity: debug | info | warn | error  (default: info)
LOG_LEVEL=info

# The word that addresses the bot (default: jarvis)
JARVIS_PREFIX=jarvis

# AI (optional). With a token set, an addressed message that is not an exact command is mapped to one
# or more commands (a chain) in plain language - for anyone who may use Jarvis there, each still subject
# to every permission check; the bot echoes what it understood ("Understood: jarvis ..."). A sensitive
# command (one affecting the bot - owner/reset/shutdown/restart/logout - or destroying data - note
# clear, schedule clear, link remove, groups deactivate) is never auto-run from a guess; you must type
# it. The OWNER can also turn on a chatbot mode per chat with "jarvis ai on" ("ai off" closes it), so
# Jarvis answers general questions too. Without a token, only exact commands work; a failed call falls
# back to normal behaviour.
#   GITHUB_MODELS_TOKEN : a GitHub personal access token with the `models` scope. SECRET - set it in
#                         `.env` (this is `.env.example`); never commit a real token.
#   JARVIS_AI_MODEL     : model id (default openai/gpt-4o-mini - cheap and reliable for this).
#   JARVIS_AI_BASE_URL  : OpenAI-compatible endpoint (default GitHub Models; point at Azure AI
#                         Foundry / OpenAI / etc. to switch provider with no code change).
GITHUB_MODELS_TOKEN=
#   JARVIS_PERSONA_FILE : OPTIONAL path to a file holding Jarvis's chatbot persona - its VOICE when the
#                         owner has turned on chatbot mode (`jarvis ai on`), e.g. data/persona.md. Edit
#                         it to change the tone with no rebuild; empty/missing uses the built-in voice.
#                         The functional rules (tool use, "*" handling, ...) are always kept, so a custom
#                         persona changes tone only, never the command discipline.
JARVIS_AI_MODEL=openai/gpt-4o-mini
JARVIS_AI_BASE_URL=https://models.github.ai/inference
JARVIS_PERSONA_FILE=
#   JARVIS_AI_DAILY_TOKEN_CAP : OPTIONAL hard daily budget for the AI layer. Once this many model
#                         tokens have been spent across all chats in a server-local day, Jarvis stops
#                         calling the model until the next day (deterministic commands keep working);
#                         "jarvis ai" shows today's spend vs the cap. 0 or unset = no cap.
JARVIS_AI_DAILY_TOKEN_CAP=0

# Where the SQLite files live (advanced; defaults are fine). JARVIS_DB is the app data (notes,
# schedules, access lists, activations, links); JARVIS_AUTH_DB is the WhatsApp credentials, kept
# separate so a data wipe never touches the login. Both default under the data volume.
JARVIS_DB=data/jarvis.db
JARVIS_AUTH_DB=data/wa-auth.db

# Container time zone - sets what "server-local" means for scheduled messages: `jarvis schedule at
# <date> <time>` fires at this zone's wall-clock. Default Europe/Bucharest (UTC+3 in summer, +2 in
# winter). Use any IANA name (e.g. Europe/London), or Etc/GMT-3 for a fixed UTC+3 with no DST.
TZ=Europe/Bucharest

# How often (ms) the background runner fires due scheduled messages (default: 30000). Lower it
# to test schedules faster locally.
JARVIS_TICK_MS=30000

# RSS/Atom feed digests (the `jarvis feed` command). JARVIS_FEED_INTERVAL_MS is how often Jarvis checks
# subscribed feeds for new entries - a separate, slower loop than JARVIS_TICK_MS so feed servers are not
# hit often (default 600000 = 10 min). JARVIS_FEED_TIMEOUT_MS bounds each fetch (default 10000), and
# JARVIS_FEED_MAX_BYTES caps how much of a feed response is read into memory (default 2000000 = 2 MB).
JARVIS_FEED_INTERVAL_MS=600000
JARVIS_FEED_TIMEOUT_MS=10000
JARVIS_FEED_MAX_BYTES=2000000

# How many times Jarvis retries a dropped connection (with exponential backoff) before giving up and
# letting the supervisor restart a clean process (default: 10). A session takeover, a ban, or an
# unrecoverable session is never retried - the bot stays down so it cannot fight or hammer WhatsApp.
JARVIS_MAX_RECONNECTS=10

# Liveness heartbeat for the container healthcheck. While connected, the bot stamps the current time
# into JARVIS_HEALTH_FILE every JARVIS_HEALTH_INTERVAL_MS; the healthcheck reports unhealthy once that
# stamp is older than JARVIS_HEALTH_MAX_AGE_MS (process wedged or disconnected too long). Defaults are
# fine; the file lives in the data volume so the healthcheck inside the container can read it.
JARVIS_HEALTH_FILE=data/health
JARVIS_HEALTH_INTERVAL_MS=20000
JARVIS_HEALTH_MAX_AGE_MS=120000

# Send pacing + human-timing (ban-safety on the unofficial client). Jarvis behaves like a person:
# it marks a message "seen" before replying, shows "typing..." for roughly as long as the reply
# would take to type, and never sends two messages closer together than a minimum spacing. A
# single global limiter governs all output; there are no hourly/daily volume caps. All optional;
# defaults are conservative.
#   *_MIN_INTERVAL_MS : floor between any two sends.  *_JITTER_MS : random extra delay per send.
#   TYPING_PER_CHAR_MS / TYPING_MAX_MS : "typing..." duration = length x per-char, capped.
#   READ_DELAY_MS : pause before marking a message read.  READ_RECEIPTS=off : never send "seen".
#   MARK_ONLINE=off : connect as offline. Default on, and REQUIRED for delivery (two ticks) and
#                     read receipts to register - an offline client leaves messages on one tick.
#                     (Blue ticks also need the account's "Read receipts" privacy setting ON.)
#   PROFILE_NAME : WhatsApp only broadcasts the online presence if the account has a profile name,
#                  so if it has none this name is set on connect. Empty = never change the name.
JARVIS_SEND_MIN_INTERVAL_MS=800
JARVIS_SEND_JITTER_MS=400
JARVIS_TYPING_PER_CHAR_MS=50
JARVIS_TYPING_MAX_MS=6000
JARVIS_READ_DELAY_MS=1000
JARVIS_READ_RECEIPTS=on
JARVIS_MARK_ONLINE=on
JARVIS_PROFILE_NAME=Jarvis
